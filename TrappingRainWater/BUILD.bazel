load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

cc_library(
    name = "main_lib",
    srcs = ["main.cpp"],
    hdrs = ["main.h"],
    copts = ["-std=c++20"],
)

cc_binary(
    name = "main",
    deps = [":main_lib"],
    copts = ["-std=c++20"],
)

cc_test(
    name = "main_test",
    srcs = [
        "main_test.cpp",
    ],
    deps = [
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        ":main_lib"
    ],
    copts = ["-std=c++20"]
)
